# --- RUNTIME & PROTOCOL ---
NODE_ENV=production
PORT=5000

# --- DATABASE ---
# MongoDB Atlas Replica Set Connection URI with SSL/TLS
MONGODB_URI=mongodb+srv://puzzolana_prod_user:StrongPassword2026!@puzzolana-cluster.mongodb.net/puzzolana_production?retryWrites=true&w=majority

# --- AUTHENTICATION & JWT ---
# Generate using `openssl rand -hex 32` (Must be at least 64 chars in production)
JWT_SECRET=8f4a1c7e9b2d3f6a5c8e0b1d4f7a2c5e8b0d3f6a9c2e5b8d1f4a7c0e3b6d9f2a
JWT_EXPIRES_IN=7d

# --- CORS & DOMAINS ---
CORS_ORIGIN=https://puzzolana.com

# --- FRONTEND CLIENT ENVS ---
NEXT_PUBLIC_API_URL=https://puzzolana.com/api
NEXT_PUBLIC_SITE_URL=https://puzzolana.com

# --- CORPORATE SMTP DISPATCHER ---
EMAIL_HOST=smtp.office365.com
