# ==============================================================================
# PUZZOLANA MACHINERY - ENTERPRISE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in backend/ and frontend/.env.local for local development.

# --- SERVER & RUNTIME ---
PORT=5000
NODE_ENV=development

# --- DATABASE (MongoDB Atlas / Local) ---
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/puzzolana?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/puzzolana_machinery

# --- AUTHENTICATION & SECURITY ---
# Minimum 32 characters secure random string
JWT_SECRET=puzzolana_enterprise_machinery_secret_key_2026_production_grade_32char
JWT_EXPIRES_IN=7d

# --- CORS & CLIENT ORIGINS ---
CORS_ORIGIN=http://localhost:3000

# --- FRONTEND CLIENT ENVS ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- EMAIL / SMTP (Nodemailer for B2B Quotations & Notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=enquiries@puzzolana.com
EMAIL_PASSWORD=your_secure_email_app_password
EMAIL_FROM="Puzzolana Machinery <no-reply@puzzolana.com>"
ADMIN_NOTIFICATION_EMAIL=sales@puzzolana.com

# --- FILE STORAGE / UPLOADS ---
UPLOAD_PROVIDER=local
UPLOAD_MAX_SIZE_MB=15
UPLOAD_API_KEY=

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
